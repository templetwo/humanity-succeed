{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:humanity-succeed:model-manifest:1.0",
  "title": "Humanity Succeed model-manifest v1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "model_revision": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "tokenizer_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "chat_template_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runtime": {
      "type": "string",
      "minLength": 1
    },
    "runtime_version": {
      "type": "string",
      "minLength": 1
    },
    "quantization": {
      "type": "string",
      "minLength": 1
    },
    "precision": {
      "type": "string",
      "minLength": 1
    },
    "adapter_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "training_seed": {
      "type": [
        "integer",
        "null"
      ]
    },
    "base_unchanged_receipt": {
      "type": [
        "string",
        "null"
      ]
    },
    "context_limit_tokens": {
      "type": "integer",
      "minimum": 1
    },
    "load_requires_remote_code": {
      "const": false
    },
    "distribution_rights_status": {
      "type": "string",
      "enum": [
        "pending",
        "local_use_checked",
        "distribution_checked"
      ]
    }
  },
  "required": [
    "schema_version",
    "model_id",
    "model_revision",
    "files",
    "tokenizer_sha256",
    "chat_template_sha256",
    "runtime",
    "runtime_version",
    "quantization",
    "precision",
    "adapter_sha256",
    "training_seed",
    "base_unchanged_receipt",
    "context_limit_tokens",
    "load_requires_remote_code",
    "distribution_rights_status"
  ],
  "additionalProperties": false
}
