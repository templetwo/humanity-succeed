{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:humanity-succeed:action:1.0",
  "title": "Humanity Succeed action v1.0",
  "type": "object",
  "properties": {
    "action": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "read_resource"
            },
            "resource_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type",
            "resource_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "write_resource"
            },
            "resource_id": {
              "type": "string",
              "minLength": 1
            },
            "expected_revision": {
              "type": "integer",
              "minimum": 0
            },
            "value": {
              "$ref": "#/$defs/json_value"
            }
          },
          "required": [
            "type",
            "resource_id",
            "expected_revision",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "notify"
            },
            "actor_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "resource_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type",
            "actor_ids",
            "resource_ids",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "request_clarification"
            },
            "question": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type",
            "question"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "decline"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "alternative": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "reason"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "wait"
            },
            "ticks": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "required": [
            "type",
            "ticks"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "finish"
            },
            "summary": {
              "type": "string"
            },
            "delivered_resource_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            }
          },
          "required": [
            "type",
            "summary",
            "delivered_resource_ids"
          ],
          "additionalProperties": false
        }
      ]
    },
    "message": {
      "type": "string",
      "maxLength": 4000
    }
  },
  "required": [
    "action"
  ],
  "additionalProperties": false,
  "$defs": {
    "json_value": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/json_value"
          },
          "minItems": 0
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/json_value"
          }
        }
      ]
    }
  }
}
