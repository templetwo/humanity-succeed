
==============================================================================
A9a: agreement_between_reviewers on punctuation-only variants
==============================================================================
  'anthony' vs 'anthony.': refused (agreement_between_reviewers refuses reviewer_ref 'anthony' a...)
  'anthony' vs 'anthony-': refused (agreement_between_reviewers refuses reviewer_ref 'anthony' a...)
  'anthony' vs 'anthony 2': ACCEPTED raw_agreement=1.0
  'a.vasquez' vs 'a-vasquez': refused (agreement_between_reviewers refuses reviewer_ref 'a.vasquez'...)
  'anthony' vs 'Anthony': refused (agreement_between_reviewers refuses reviewer_ref 'anthony' a...)
  'anthony' vs 'anthony ': refused (agreement_between_reviewers refuses reviewer_ref 'anthony' a...)
  '.' vs '..': refused (agreement_between_reviewers refuses reviewer_ref '.' and '.....)
  'anthony' vs 'anthony2': ACCEPTED raw_agreement=1.0

==============================================================================
A9b: canonical forms and problems for admitted references
==============================================================================
  'anthony'            canonical='anthony'            problem=None
  'anthony.'           canonical='anthony'            problem=None
  'anthony-'           canonical='anthony'            problem=None
  'anthony_'           canonical='anthony'            problem=None
  'anthony 2'          canonical='anthony2'           problem=None
  '.'                  canonical=''                   problem=reviewer_ref '.' has no letter or digit; separators alone cannot name a reviewer (B61)
  '-'                  canonical=''                   problem=reviewer_ref '-' has no letter or digit; separators alone cannot name a reviewer (B61)
  '0'                  canonical='0'                  problem=None
  'anthony vasquez'    canonical='anthonyvasquez'     problem=None
  'anthonyvasquez'     canonical='anthonyvasquez'     problem=None

